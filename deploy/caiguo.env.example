# 踩过正式环境配置。复制到 /etc/caiguo/caiguo.env，权限 600，属主 caiguo。
# 每一项的说明见 docs/DEPLOY.md。

CAIGUO_ENV=production
PORT=8787
CAIGUO_DB=/var/lib/caiguo/caiguo.db
CAIGUO_PUBLIC_URL=https://caiguo.example.cn
# 服务在 Caddy / Nginx 后面时必须打开，否则所有人的 IP 都是 127.0.0.1，按 IP 的限流会互相影响
CAIGUO_TRUST_PROXY=1

# 手机号哈希密钥：openssl rand -hex 32 生成。上线后不能再换（换了旧账号的手机号全部对不上）
CAIGUO_PHONE_PEPPER=

# 短信：平台把 {"phone","code","template":"login"} POST 到这个地址，由你的短信转发服务调用阿里云 / 腾讯云
CAIGUO_SMS_WEBHOOK=
CAIGUO_SMS_TOKEN=

# 虚拟运营商号段（170/171/162/165/167）默认不能注册；确实要放开时设为 1
# CAIGUO_ALLOW_VIRTUAL=1
