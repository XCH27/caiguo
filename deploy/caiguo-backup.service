# /etc/systemd/system/caiguo-backup.service（由 caiguo-backup.timer 每天触发）
[Unit]
Description=踩过数据库备份

[Service]
Type=oneshot
User=caiguo
Group=caiguo
WorkingDirectory=/opt/caiguo
EnvironmentFile=/etc/caiguo/caiguo.env
ExecStart=/usr/bin/node --no-warnings=ExperimentalWarning scripts/backup.js --out /var/lib/caiguo/backups --keep 14
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/caiguo
