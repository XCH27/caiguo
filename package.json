    "demo": "node --no-warnings=ExperimentalWarning scripts/seed.js --reset && node --no-warnings=ExperimentalWarning server/index.js",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0"
  },
