{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__.*caiguo.*",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/track.js\" post", "timeout": 5 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/track.js\" stop", "timeout": 5 }]
      }
    ]
  }
}
